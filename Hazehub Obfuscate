<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Haze Obfuscate</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    
    :root {
      --mist-white: #ffffff;
      --mist-light: #f5f7fa;
      --mist-gray: #e8ecf1;
      --mist-medium: #c5cdd6;
      --mist-dark: #8a95a5;
      --mist-darker: #5a6675;
      --mist-deep: #3d4856;
      --haze-accent: #a0aec0;
      --shadow-soft: rgba(160, 174, 192, 0.15);
      --shadow-medium: rgba(160, 174, 192, 0.25);
    }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: linear-gradient(135deg, var(--mist-white) 0%, var(--mist-light) 50%, var(--mist-gray) 100%);
      min-height: 100vh;
      color: var(--mist-deep);
      overflow-x: hidden;
    }

    .mist-bg {
      position: fixed;
      top: 0; left: 0;
      width: 100%; height: 100%;
      pointer-events: none;
      z-index: 0;
      overflow: hidden;
    }

    .mist-particle {
      position: absolute;
      background: radial-gradient(circle, rgba(255,255,255,0.8) 0%, rgba(240,245,250,0.4) 50%, transparent 100%);
      border-radius: 50%;
      animation: float 20s infinite ease-in-out;
    }

    @keyframes float {
      0%, 100% { transform: translateY(0) translateX(0) scale(1); opacity: 0.6; }
      33% { transform: translateY(-30px) translateX(20px) scale(1.1); opacity: 0.8; }
      66% { transform: translateY(20px) translateX(-20px) scale(0.9); opacity: 0.4; }
    }

    .container {
      position: relative;
      z-index: 1;
      max-width: 1400px;
      margin: 0 auto;
      padding: 20px;
    }

    header {
      text-align: center;
      padding: 40px 20px;
      margin-bottom: 20px;
    }

    .logo {
      font-size: 3rem;
      font-weight: 300;
      letter-spacing: 8px;
      color: var(--mist-darker);
      text-shadow: 2px 2px 8px var(--shadow-soft);
      margin-bottom: 10px;
    }

    .logo span { font-weight: 600; color: var(--mist-deep); }

    .tagline {
      color: var(--mist-dark);
      font-size: 1.1rem;
      letter-spacing: 3px;
      text-transform: uppercase;
    }

    .main-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-bottom: 20px;
    }

    @media (max-width: 900px) {
      .main-grid { grid-template-columns: 1fr; }
    }

    .panel {
      background: rgba(255, 255, 255, 0.7);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.8);
      border-radius: 20px;
      padding: 25px;
      box-shadow: 0 8px 32px var(--shadow-soft);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .panel:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 40px var(--shadow-medium);
    }

    .panel-header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 20px;
      padding-bottom: 15px;
      border-bottom: 1px solid var(--mist-gray);
    }

    .panel-icon {
      width: 40px; height: 40px;
      background: linear-gradient(135deg, var(--mist-gray), var(--mist-light));
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.2rem;
      box-shadow: 0 2px 8px var(--shadow-soft);
    }

    .panel-title {
      font-size: 1.2rem;
      font-weight: 600;
      color: var(--mist-deep);
    }

    textarea {
      width: 100%;
      min-height: 300px;
      background: rgba(255, 255, 255, 0.5);
      border: 1px solid var(--mist-medium);
      border-radius: 12px;
      padding: 15px;
      font-family: 'Consolas', 'Monaco', monospace;
      font-size: 0.9rem;
      color: var(--mist-deep);
      resize: vertical;
      transition: all 0.3s ease;
    }

    textarea:focus {
      outline: none;
      border-color: var(--haze-accent);
      box-shadow: 0 0 0 3px rgba(160, 174, 192, 0.2);
      background: rgba(255, 255, 255, 0.8);
    }

    .controls {
      display: flex;
      gap: 12px;
      margin-top: 15px;
      flex-wrap: wrap;
    }

    .btn {
      padding: 12px 24px;
      border: none;
      border-radius: 12px;
      font-size: 0.95rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
      display: flex;
      align-items: center;
      gap: 8px;
      box-shadow: 0 4px 12px var(--shadow-soft);
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--mist-darker), var(--mist-deep));
      color: white;
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px var(--shadow-medium);
    }

    .btn-secondary {
      background: linear-gradient(135deg, var(--mist-gray), var(--mist-light));
      color: var(--mist-darker);
      border: 1px solid var(--mist-medium);
    }

    .btn-secondary:hover {
      background: linear-gradient(135deg, var(--mist-medium), var(--mist-gray));
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 15px;
      margin-top: 20px;
    }

    .stat-card {
      background: rgba(255, 255, 255, 0.6);
      border-radius: 12px;
      padding: 15px;
      text-align: center;
      border: 1px solid rgba(255, 255, 255, 0.8);
    }

    .stat-value {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--mist-deep);
    }

    .stat-label {
      font-size: 0.8rem;
      color: var(--mist-dark);
      margin-top: 5px;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .ai-panel {
      margin-top: 20px;
      background: rgba(255, 255, 255, 0.7);
      backdrop-filter: blur(12px);
      border-radius: 20px;
      padding: 25px;
      box-shadow: 0 8px 32px var(--shadow-soft);
      border: 1px solid rgba(255, 255, 255, 0.8);
    }

    .ai-chat {
      height: 300px;
      overflow-y: auto;
      background: rgba(255, 255, 255, 0.5);
      border-radius: 12px;
      padding: 15px;
      margin-bottom: 15px;
      border: 1px solid var(--mist-gray);
    }

    .chat-message {
      margin-bottom: 12px;
      padding: 10px 15px;
      border-radius: 12px;
      max-width: 80%;
      animation: fadeIn 0.3s ease;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .chat-message.user {
      background: linear-gradient(135deg, var(--mist-darker), var(--mist-deep));
      color: white;
      margin-left: auto;
      border-bottom-right-radius: 4px;
    }

    .chat-message.ai {
      background: rgba(255, 255, 255, 0.9);
      color: var(--mist-deep);
      border: 1px solid var(--mist-gray);
      border-bottom-left-radius: 4px;
    }

    .ai-input-group {
      display: flex;
      gap: 10px;
    }

    .ai-input {
      flex: 1;
      padding: 12px 20px;
      border: 1px solid var(--mist-medium);
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.8);
      font-size: 0.95rem;
      color: var(--mist-deep);
    }

    .ai-input:focus {
      outline: none;
      border-color: var(--haze-accent);
      box-shadow: 0 0 0 3px rgba(160, 174, 192, 0.2);
    }

    .badge {
      display: inline-block;
      padding: 4px 12px;
      background: linear-gradient(135deg, var(--mist-gray), var(--mist-light));
      border-radius: 20px;
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--mist-darker);
      margin-left: 10px;
      border: 1px solid var(--mist-medium);
    }

    .options {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
      margin-bottom: 15px;
    }

    .option {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px;
      background: rgba(255, 255, 255, 0.5);
      border-radius: 8px;
      cursor: pointer;
      transition: background 0.2s;
    }

    .option:hover { background: rgba(255, 255, 255, 0.8); }

    .option input[type="checkbox"] {
      width: 18px; height: 18px;
      accent-color: var(--mist-darker);
    }

    .option label {
      font-size: 0.85rem;
      color: var(--mist-darker);
      cursor: pointer;
    }

    footer {
      text-align: center;
      padding: 30px;
      color: var(--mist-dark);
      font-size: 0.9rem;
    }

    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-track { background: var(--mist-light); }
    ::-webkit-scrollbar-thumb { background: var(--mist-medium); border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: var(--mist-dark); }
  </style>
</head>
<body>
  <div class="mist-bg" id="mistBg"></div>

  <div class="container">
    <header>
      <h1 class="logo">HAZE <span>OBFUSCATE</span></h1>
      <p class="tagline">Advanced Code Protection in the Mist</p>
    </header>

    <div class="main-grid">
      <div class="panel">
        <div class="panel-header">
          <div class="panel-icon">📄</div>
          <div class="panel-title">Source Code</div>
        </div>
        <textarea id="inputCode" placeholder="// Paste your JavaScript code here...
function helloWorld() {
    const message = 'Hello, World!';
    console.log(message);
    return message;
}"></textarea>
        
        <div class="options">
          <div class="option">
            <input type="checkbox" id="optRename" checked>
            <label for="optRename">Rename Variables</label>
          </div>
          <div class="option">
            <input type="checkbox" id="optStrings" checked>
            <label for="optStrings">Encode Strings</label>
          </div>
          <div class="option">
            <input type="checkbox" id="optCompact" checked>
            <label for="optCompact">Compact Code</label>
          </div>
          <div class="option">
            <input type="checkbox" id="optDeadCode">
            <label for="optDeadCode">Add Dead Code</label>
          </div>
        </div>

        <div class="controls">
          <button class="btn btn-primary" onclick="obfuscate()">🔒 Obfuscate</button>
          <button class="btn btn-secondary" onclick="clearCode()">🗑️ Clear</button>
          <button class="btn btn-secondary" onclick="loadExample()">📋 Example</button>
        </div>
      </div>

      <div class="panel">
        <div class="panel-header">
          <div class="panel-icon">🔐</div>
          <div class="panel-title">Obfuscated Output</div>
        </div>
        <textarea id="outputCode" readonly placeholder="// Obfuscated code will appear here..."></textarea>
        
        <div class="controls">
          <button class="btn btn-primary" onclick="copyOutput()">📋 Copy</button>
          <button class="btn btn-secondary" onclick="downloadOutput()">💾 Download</button>
        </div>

        <div class="stats">
          <div class="stat-card">
            <div class="stat-value" id="statSize">0</div>
            <div class="stat-label">Size (KB)</div>
          </div>
          <div class="stat-card">
            <div class="stat-value" id="statEntropy">0</div>
            <div class="stat-label">Entropy</div>
          </div>
          <div class="stat-card">
            <div class="stat-value" id="statRatio">0%</div>
            <div class="stat-label">Obfuscation</div>
          </div>
        </div>
      </div>
    </div>

    <div class="ai-panel">
      <div class="panel-header">
        <div class="panel-icon">🤖</div>
        <div class="panel-title">
          Haze AI Assistant
          <span class="badge">v2.0</span>
        </div>
      </div>
      <div class="ai-chat" id="aiChat">
        <div class="chat-message ai">
          Hello! I'm Haze AI. I can help you understand obfuscation, suggest improvements, or explain what the obfuscator does. How can I assist you today?
        </div>
      </div>
      <div class="ai-input-group">
        <input type="text" class="ai-input" id="aiInput" placeholder="Ask me anything about code obfuscation..." onkeypress="if(event.key==='Enter') sendAI()">
        <button class="btn btn-primary" onclick="sendAI()">Send</button>
      </div>
    </div>

    <footer>
      <p>Haze Obfuscate — Protecting your code in the mist since 2026</p>
    </footer>
  </div>

  <script>
    // Generate mist particles
    function createMist() {
      const container = document.getElementById('mistBg');
      for (let i = 0; i < 15; i++) {
        const particle = document.createElement('div');
        particle.className = 'mist-particle';
        const size = Math.random() * 200 + 100;
        particle.style.width = size + 'px';
        particle.style.height = size + 'px';
        particle.style.left = Math.random() * 100 + '%';
        particle.style.top = Math.random() * 100 + '%';
        particle.style.animationDelay = Math.random() * 20 + 's';
        particle.style.animationDuration = (Math.random() * 10 + 15) + 's';
        container.appendChild(particle);
      }
    }
    createMist();

    // Obfuscation engine
    function obfuscate() {
      let code = document.getElementById('inputCode').value;
      if (!code.trim()) {
        alert('Please enter some code to obfuscate!');
        return;
      }

      const rename = document.getElementById('optRename').checked;
      const strings = document.getElementById('optStrings').checked;
      const compact = document.getElementById('optCompact').checked;
      const deadCode = document.getElementById('optDeadCode').checked;

      let obfuscated = code;

      if (rename) obfuscated = renameVariables(obfuscated);
      if (strings) obfuscated = encodeStrings(obfuscated);
      if (compact) obfuscated = compactCode(obfuscated);
      if (deadCode) obfuscated = insertDeadCode(obfuscated);

      obfuscated = wrapAntiDebug(obfuscated);

      document.getElementById('outputCode').value = obfuscated;
      updateStats(code, obfuscated);
    }

    function renameVariables(code) {
      const varRegex = /\b(let|const|var|function)\s+([a-zA-Z_$][a-zA-Z0-9_$]*)/g;
      const vars = new Map();
      let counter = 0;
      
      return code.replace(varRegex, (match, type, name) => {
        if (!vars.has(name)) {
          vars.set(name, '_' + generateRandomName(counter++));
        }
        return type + ' ' + vars.get(name);
      }).replace(/\b([a-zA-Z_$][a-zA-Z0-9_$]*)\b(?=\s*\()/g, (match) => {
        return vars.get(match) || match;
      }).replace(/\b([a-zA-Z_$][a-zA-Z0-9_$]*)\b(?![\s]*:)/g, (match) => {
        return vars.get(match) || match;
      });
    }

    function generateRandomName(index) {
      const chars = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_$';
      let result = '';
      let n = index;
      do {
        result = chars[n % chars.length] + result;
        n = Math.floor(n / chars.length);
      } while (n > 0);
      return result || '_';
    }

    function encodeStrings(code) {
      return code.replace(/(['"`])(?:(?=(\\?))\2.)*?\1/g, (match) => {
        const str = match.slice(1, -1);
        let encoded = '';
        for (let i = 0; i < str.length; i++) {
          encoded += '\\x' + str.charCodeAt(i).toString(16).padStart(2, '0');
        }
        return "'" + encoded + "'";
      });
    }

    function compactCode(code) {
      return code
        .replace(/\/\/.*$/gm, '')
        .replace(/\/\*[\s\S]*?\*\//g, '')
        .replace(/\s+/g, ' ')
        .replace(/\s*([{}();,=+\-*/<>!&|])\s*/g, '$1')
        .trim();
    }

    function insertDeadCode(code) {
      const deadSnippets = [
        'if(false){var _unused=Math.random();}',
        'while(false){break;}',
        'try{if(0){throw 0;}}catch(_e){}',
        '(function(){var _x;return;_x=1;})();'
      ];
      
      let result = code;
      for (let i = 0; i < 3; i++) {
        const pos = Math.floor(Math.random() * result.length);
        const snippet = deadSnippets[Math.floor(Math.random() * deadSnippets.length)];
        result = result.slice(0, pos) + snippet + result.slice(pos);
      }
      return result;
    }

    function wrapAntiDebug(code) {
      return `(function(){\nvar _0xstart=new Date();\ndebugger;\nif(new Date()-_0xstart>100)return;\n${code}\n})();`;
    }

    function updateStats(original, obfuscated) {
      const origSize = new Blob([original]).size / 1024;
      const obfSize = new Blob([obfuscated]).size / 1024;
      
      document.getElementById('statSize').textContent = obfSize.toFixed(2);
      
      let entropy = 0;
      const len = obfuscated.length;
      const freq = {};
      for (let char of obfuscated) {
        freq[char] = (freq[char] || 0) + 1;
      }
      for (let char in freq) {
        const p = freq[char] / len;
        entropy -= p * Math.log2(p);
      }
      document.getElementById('statEntropy').textContent = entropy.toFixed(2);
      
      const ratio = ((obfSize - origSize) / origSize * 100);
      document.getElementById('statRatio').textContent = (ratio > 0 ? '+' : '') + ratio.toFixed(0) + '%';
    }

    function clearCode() {
      document.getElementById('inputCode').value = '';
      document.getElementById('outputCode').value = '';
      document.getElementById('statSize').textContent = '0';
      document.getElementById('statEntropy').textContent = '0';
      document.getElementById('statRatio').textContent = '0%';
    }

    function loadExample() {
      document.getElementById('inputCode').value = `// Example: User Authentication Module\nfunction authenticateUser(username, password) {\n    const secretKey = "my_secret_key_123";\n    const hashedPass = btoa(password + secretKey);\n    \n    if (username === "admin" && hashedPass === "YWRtaW5teV9zZWNyZXRfa2V5XzEyMw==") {\n        console.log("Access granted to admin panel");\n        return { status: "success", role: "admin", token: generateToken() };\n    }\n    \n    return { status: "denied", message: "Invalid credentials" };\n}\n\nfunction generateToken() {\n    return Math.random().toString(36).substring(2) + Date.now().toString(36);\n}\n\nconst users = ["alice", "bob", "charlie"];\nusers.forEach(user => {\n    console.log("Checking user:", user);\n});`;
    }

    function copyOutput() {
      const output = document.getElementById('outputCode');
      output.select();
      document.execCommand('copy');
      
      const btn = event.target;
      const original = btn.textContent;
      btn.textContent = '✅ Copied!';
      setTimeout(() => btn.textContent = original, 2000);
    }

    function downloadOutput() {
      const code = document.getElementById('outputCode').value;
      if (!code) return;
      
      const blob = new Blob([code], { type: 'text/javascript' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'obfuscated.js';
      a.click();
      URL.revokeObjectURL(url);
    }

    // AI Assistant
    const aiResponses = {
      'obfuscate': 'Obfuscation transforms readable code into a difficult-to-understand format while maintaining functionality. It protects intellectual property and makes reverse engineering harder.',
      'rename': 'Variable renaming replaces meaningful names like "userPassword" with short random identifiers like "_a" or "_0x1", making the code harder to understand without changing behavior.',
      'string': 'String encoding converts readable text into hexadecimal escape sequences. For example, "hello" becomes "\\x68\\x65\\x6c\\x6c\\x6f".',
      'compact': 'Compacting removes whitespace, comments, and unnecessary characters. This reduces file size and makes the code harder to read.',
      'dead code': 'Dead code injection adds non-functional code blocks that never execute, confusing deobfuscators and increasing analysis complexity.',
      'debug': 'Anti-debugging techniques detect if developer tools are open and can alter program behavior or crash the debugger to prevent analysis.',
      'help': 'I can explain obfuscation techniques, suggest security improvements, or help you understand what each option does. What would you like to know?',
      'default': 'That\'s an interesting question! In the context of code obfuscation, I recommend enabling all protection layers for maximum security. Would you like me to explain any specific technique?'
    };

    function sendAI() {
      const input = document.getElementById('aiInput');
      const message = input.value.trim();
      if (!message) return;

      const chat = document.getElementById('aiChat');
      
      // Add user message
      const userMsg = document.createElement('div');
      userMsg.className = 'chat-message user';
      userMsg.textContent = message;
      chat.appendChild(userMsg);
      
      input.value = '';
      chat.scrollTop = chat.scrollHeight;

      // Simulate AI thinking
      setTimeout(() => {
        const aiMsg = document.createElement('div');
        aiMsg.className = 'chat-message ai';
        
        const lowerMsg = message.toLowerCase();
        let response = aiResponses.default;
        
        for (let key in aiResponses) {
          if (lowerMsg.includes(key)) {
            response = aiResponses[key];
            break;
          }
        }
        
        aiMsg.textContent = response;
        chat.appendChild(aiMsg);
        chat.scrollTop = chat.scrollHeight;
      }, 800);
    }
  </script>
</body>
</html>
